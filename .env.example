# Canonical production origin. Used for metadataBase, robots.txt and sitemap.xml.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — local defaults from `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Never prefix with NEXT_PUBLIC_ — this bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=

# Where the money goes. Both are shown to customers, so both are public on
# purpose — there is no secret here. Leaving either blank is not an error:
# the site drops the WhatsApp link rather than rendering a dead wa.me href,
# and the payment panel falls back to "message us for the till number".
NEXT_PUBLIC_MPESA_TILL=
NEXT_PUBLIC_WHATSAPP_NUMBER=